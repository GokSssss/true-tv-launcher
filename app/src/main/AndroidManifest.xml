   <intent-filter><action android:name="android.intent.action.OPEN_DOCUMENT_TREE"/><action android:name="org.openintents.action.PICK_DIRECTORY"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
  </activity>
  <activity android:name="ru.truetv.launcher.CatalogActivity" android:exported="false" android:windowSoftInputMode="stateAlwaysHidden" />
  <activity android:name="ru.truetv.launcher.SettingsActivity" android:exported="false" />
  <activity android:name="ru.truetv.launcher.BluetoothScreens" android:exported="false" android:windowSoftInputMode="stateAlwaysHidden" />
  <activity android:name="ru.truetv.launcher.AccessActivity" android:exported="false" />
  <activity android:name="ru.truetv.launcher.ExpertActivity" android:exported="false" />
  <activity android:name="ru.truetv.launcher.IrRemoteActivity" android:exported="false" android:windowSoftInputMode="stateAlwaysHidden" />
  <activity android:name="ru.truetv.launcher.ShareSettingsActivity" android:exported="false" android:theme="@android:style/Theme.Material.Dialog.Alert" android:excludeFromRecents="true" />
  <activity android:name="ru.truetv.bridge.android.SendActivity" android:exported="false" android:theme="@android:style/Theme.Material.Dialog.Alert" />
  <service android:name="ru.truetv.bridge.android.SendService" android:exported="false" android:foregroundServiceType="connectedDevice" />
  <service android:name="ru.truetv.launcher.ControlService" android:label="@string/control_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
   <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
   <meta-data android:name="android.accessibilityservice" android:resource="@xml/control_service" />
  </service>
 </application>
